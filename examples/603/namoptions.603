&RUN
iexpnr       = 603
runtime      = 3600.
trestart     = 600.
dtmax        = 1.
ladaptive    = .true.
nprocx       = 4
nprocy       = 2
/

&OUTPUT
lfielddump   = .true.
tfielddump   = 30.
fieldvars    = 'u0,v0,w0'
ltdump       = .true.
lxytdump     = .true.
tstatsdump   = 10.
tsample      = 1.
/

&DOMAIN
itot = 128
jtot = 128
ktot = 128
xlen         = 64
ylen         = 64
/

&INP
zsize = 64.
u0 = 1.
dpdx         = 0.0001
stl_file = 'flat_ground.stl'
  thl0 = 290.
/

&WALLS
nfcts = 128
nsolpts_u = 0
nsolpts_v = 0
nsolpts_w = 16384
nsolpts_c = 0
nbndpts_u = 16384
nbndpts_v = 16384
nbndpts_w = 16384
nbndpts_c = 16384
nfctsecs_u = 17788
nfctsecs_v = 17788
nfctsecs_w = 0
nfctsecs_c = 16896
/

&TREES
ltrees = .true.
itree_mode   = 99
ntrees = 12544
cd = 0.3
lad          = 1.0
lsize = 0.15
ud = 0.0002
dec          = 0.3
Qstar        = 600
dQdt         = 0
r_s          = 50.
ltreedump    = .true.
/
&PHYSICS
  dpdx = 0.0001
/
&ENERGYBALANCE
  nfaclyrs = 3
/
