#!/bin/bash
#PBS -N udales_merge
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o udales_merge.log

# Load NCO for the merge tools
module load NCO/5.2.9-foss-2024a

# Job name
EXPNAME=603

# Set folder names
PROJECT_DIR=$HOME/uDALES

# Stage raw simulation output from EPHEMERAL to fast local scratch
cp -r $EPHEMERAL/uDALES/outputs/$EXPNAME $TMPDIR/$EXPNAME

# Run merge
$PROJECT_DIR/u-dales/tools/gather_outputs.sh $TMPDIR/$EXPNAME || exit 1

# Copy files back to home
mkdir -p $PROJECT_DIR/outputs/$EXPNAME
rsync -a \
  --exclude='fielddump.[0-9][0-9][0-9].*.nc' \
  --exclude='tdump.[0-9][0-9][0-9].*.nc' \
  --exclude='treedump.[0-9][0-9][0-9].*.nc' \
  "$TMPDIR/$EXPNAME/" "$PROJECT_DIR/outputs/$EXPNAME/"
